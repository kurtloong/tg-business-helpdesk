# Copy to .env. Generate separate secrets: openssl rand -hex 32
# Password must be hex/alphanumeric (no spaces, quotes, or $).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
WEBHOOK_SECRET=REPLACE_WITH_RANDOM_HEX_AT_LEAST_32_CHARACTERS
ADMIN_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_HEX_AT_LEAST_32_CHARS
SUPPORT_GROUP_ID=-1001234567890
AGENT_IDS=222222222,333333333
WEBHOOK_URL=https://support.example.com/webhook
# Local Go execution only: Compose injects its own DSN.
DATABASE_URL='host=127.0.0.1 user=helpdesk password=REPLACE_WITH_RANDOM_HEX dbname=helpdesk port=5432 sslmode=disable TimeZone=UTC'
